<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <?if $(var.Platform) = x64 ?>
    <?define Win64 = "yes" ?>
    <?define PlatformProgramFilesFolder = "ProgramFiles64Folder" ?>
  <?else ?>
    <?define Win64 = "no" ?>
    <?define PlatformProgramFilesFolder = "ProgramFilesFolder" ?>
  <?endif ?>

  <Product Id="*" 
           Name="Omnix Player" 
           Language="1033" 
           Version="4.407.2" 
           Manufacturer="Omnix" 
           UpgradeCode="5B7C7381-893C-43F1-A894-3BC56F313388">
    <Package InstallerVersion="301" 
             Compressed="yes" 
             InstallScope="perMachine" 
             Description="Omnix Digital Signage Player" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="AppIcon" SourceFile="new-icon.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />

    <Feature Id="ProductFeature" Title="Omnix Player" Level="1">
      <ComponentGroupRef Id="OmnixFiles" />
      <ComponentRef Id="ApplicationShortcuts" />
    </Feature>

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="$(var.PlatformProgramFilesFolder)">
        <Directory Id="CompanyFolder" Name="Omnix">
          <Directory Id="INSTALLFOLDER" Name="Omnix Player" />
        </Directory>
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ApplicationProgramsFolder" Name="Omnix" />
      </Directory>
      <Directory Id="DesktopFolder" Name="Desktop" />
    </Directory>

    <DirectoryRef Id="ApplicationProgramsFolder">
      <Component Id="ApplicationShortcuts" Guid="A7697843-0941-4569-8051-5A8BE1C2A523">
        <!-- Start Menu Shortcuts -->
        <Shortcut Id="PlayerShortcut"
                  Name="Omnix Player"
                  Description="Omnix Digital Signage Player"
                  Target="[INSTALLFOLDER]OmnixPlayer.exe"
                  Arguments="player"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="AppIcon" />
        <Shortcut Id="OptionsShortcut"
                  Name="Omnix Player Options"
                  Description="Configure Omnix Player"
                  Target="[INSTALLFOLDER]OmnixPlayer.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="AppIcon" />
        
        <!-- Desktop Shortcuts -->
        <Shortcut Id="DesktopPlayerShortcut"
                  Directory="DesktopFolder"
                  Name="Omnix Player"
                  Description="Omnix Digital Signage Player"
                  Target="[INSTALLFOLDER]OmnixPlayer.exe"
                  Arguments="player"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="AppIcon" />
        <Shortcut Id="DesktopOptionsShortcut"
                  Directory="DesktopFolder"
                  Name="Omnix Player Options"
                  Description="Configure Omnix Player"
                  Target="[INSTALLFOLDER]OmnixPlayer.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="AppIcon" />

        <RemoveFolder Id="CleanUpShortcuts" Directory="ApplicationProgramsFolder" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\Omnix\OmnixPlayer" Name="installed" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>
  </Product>
</Wix>
